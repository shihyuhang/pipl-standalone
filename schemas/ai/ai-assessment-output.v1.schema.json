{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipl.local/schemas/ai/ai-assessment-output.v1.schema.json",
  "title": "AI Assessment Draft Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_type", "summary", "suggested_triage", "findings",
    "missing_information", "suggested_tasks", "review"
  ],
  "properties": {
    "assessment_type": {
      "enum": ["qualification_explanation", "scenario_triage", "notice_review", "pipia", "audit_self_check"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "suggested_triage": {
      "type": ["string", "null"],
      "enum": [
        "SIMPLE_RECORD", "REMEDIATE_THEN_PROCEED", "PIPIA_REQUIRED",
        "EXPERT_REVIEW", "OUT_OF_SMALL_SCOPE", null
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/finding" }
    },
    "missing_information": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/missingInformation" }
    },
    "suggested_tasks": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/suggestedTask" }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reasons"],
      "properties": {
        "required": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_type", "ref_id", "locator", "supports_claim"],
      "properties": {
        "citation_type": { "enum": ["regulation", "enterprise_document", "fact", "rule_result"] },
        "ref_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 500 },
        "excerpt": { "type": ["string", "null"], "maxLength": 1000 },
        "supports_claim": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "status", "title", "description", "risk_level",
        "citations", "confidence", "review_required"
      ],
      "properties": {
        "candidate_id": { "type": "string", "format": "uuid" },
        "status": { "const": "draft" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "risk_level": { "enum": ["L0", "L1", "L2", "L3"] },
        "suggested_rule_result": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "NOT_APPLICABLE", "UNKNOWN", "NEEDS_REVIEW", null] },
        "rule_code": { "type": ["string", "null"], "pattern": "^R-[A-Z]+-[0-9]{3}$" },
        "official_mappings": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "pattern": "^[AP][0-9]{2}(?:\\.D[1-3])?$" }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/citation" }
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "uncertainty": { "type": ["string", "null"], "maxLength": 2000 },
        "review_required": { "type": "boolean" },
        "recommended_action": { "type": ["string", "null"], "maxLength": 3000 }
      }
    },
    "missingInformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description", "blocking"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "blocking": { "type": "boolean" },
        "fact_codes": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "../fact-schema.v1.json#/$defs/factCode" }
        }
      }
    },
    "suggestedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "title", "description", "acceptance_criteria", "priority", "source_finding_ids"],
      "properties": {
        "candidate_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "acceptance_criteria": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "priority": { "enum": ["low", "normal", "high", "blocking"] },
        "source_finding_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
