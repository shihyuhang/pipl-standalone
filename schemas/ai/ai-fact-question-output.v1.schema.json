{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipl.local/schemas/ai/ai-fact-question-output.v1.schema.json",
  "title": "AI Candidate Facts and Questions Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_facts", "questions", "missing_information", "warnings"],
  "properties": {
    "candidate_facts": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/candidateFact" }
    },
    "questions": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/candidateQuestion" }
    },
    "missing_information": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/missingInformation" }
    },
    "warnings": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "$defs": {
    "candidateFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "fact_code", "subject_ref", "value_type", "value",
        "status", "source_refs", "confidence", "needs_user_confirmation"
      ],
      "properties": {
        "candidate_id": { "type": "string", "format": "uuid" },
        "fact_code": { "$ref": "../fact-schema.v1.json#/$defs/factCode" },
        "subject_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_type", "local_ref"],
          "properties": {
            "subject_type": {
              "enum": [
                "enterprise", "person_category", "processing_activity", "data_field",
                "purpose", "system", "third_party", "document", "incident"
              ]
            },
            "local_ref": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "value_type": {
          "enum": ["boolean", "enum", "number", "string", "date", "datetime", "object", "list"]
        },
        "value": {},
        "status": { "const": "candidate" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "rationale": { "type": ["string", "null"], "maxLength": 2000 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "needs_user_confirmation": { "const": true },
        "conflicts_with_fact_refs": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "candidateQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "question_origin", "prompt", "answer_type", "required",
        "reason", "target_fact_codes", "priority"
      ],
      "properties": {
        "candidate_id": { "type": "string", "format": "uuid" },
        "question_origin": { "enum": ["registered", "ai_follow_up"] },
        "question_code": {
          "type": ["string", "null"],
          "pattern": "^Q-[A-Z0-9-]+$"
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "answer_type": {
          "enum": ["yes_no_unknown", "single", "multi", "number", "date", "short_text", "long_text", "table", "file"]
        },
        "options": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 100 },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        },
        "required": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "target_fact_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "../fact-schema.v1.json#/$defs/factCode" }
        },
        "priority": { "enum": ["blocking", "high", "normal", "low"] },
        "source_refs": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "question_origin": { "const": "registered" } },
            "required": ["question_origin"]
          },
          "then": { "required": ["question_code"] }
        },
        {
          "if": {
            "properties": { "answer_type": { "enum": ["single", "multi"] } },
            "required": ["answer_type"]
          },
          "then": { "required": ["options"] }
        }
      ]
    },
    "missingInformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description", "blocking"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "blocking": { "type": "boolean" },
        "target_fact_codes": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "../fact-schema.v1.json#/$defs/factCode" }
        }
      }
    }
  }
}
