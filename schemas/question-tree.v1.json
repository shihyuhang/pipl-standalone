  "globalRules": [
    {
      "code": "R-SMALL-001",
      "when": "fact('SCOPE.PERSON_COUNT').min >= 100000",
      "action": "block_formal_small_processor_conclusion",
      "message": "当前人数已达到或超过 10 万人，需转入一般个人信息处理者路径。"
    },
    {
      "code": "R-XFER-001",
      "when": "fact('ORG.OWNERSHIP') in ['foreign_invested','foreign_branch','mixed'] && !hasConfirmedOverseasStorageOrAccess()",
      "action": "keep_xfer_unknown_or_false",
      "message": "外资身份不能单独作为数据出境事实。"
    },
    {
      "code": "R-B2B-001",
      "when": "scenario.type == 'b2b_contact' && answer('Q-B2B-001') == ['company_only']",
      "action": "require_human_confirmation_before_marking_no_personal_information"
    },
    {
      "code": "R-AI-001",
      "when": "fact.sourceType == 'ai_inference'",
      "action": "force_candidate_status"
    },
    {
      "code": "R-CONFIRM-001",
      "when": "session.hasBlockingUnknown || session.hasDisputedFacts",
      "action": "block_formal_assessment_and_signature"
    }
  ],
  "aiHooks": [
    {
      "code": "AI-DOCUMENT-FACT-EXTRACTION",
      "trigger": "document_uploaded",
      "allowedOutputs": ["candidate_facts", "source_spans", "candidate_questions"],
      "forbiddenOutputs": ["confirmed_facts", "official_conclusion"]
    },
    {
      "code": "AI-SCENARIO-NORMALIZATION",
      "trigger": "free_text_scenario_submitted",
      "allowedOutputs": ["scenario_type_candidate", "purpose_candidates", "data_field_candidates", "follow_up_question_candidates"]
    },
    {
      "code": "AI-FACT-CONFLICT-DETECTION",
      "trigger": "answer_saved",
      "allowedOutputs": ["conflict_candidates", "follow_up_question_candidates"]
    }
  ]
