# 业务初步检查：auto | deepseek | qwen | kimi | dify | local
# auto 会优先选择已经配置的直连模型；均未配置时使用本地基础规则。
AI_SCENARIO_TRIAGE_PROVIDER=auto
AI_SCENARIO_TRIAGE_FALLBACK_PROVIDER=local
AI_REQUEST_TIMEOUT_MS=120000

# 材料完整草稿可在系统“AI 设置”页面选择并保存；默认会复用下方已经配置的直连模型。
# 可选：部署者提供固定的凭据加密主密钥；未填写时系统会在 data/.credentials.key 生成本机密钥。
PIPL_CREDENTIAL_SECRET=

# DeepSeek 直连
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 通义千问直连
DASHSCOPE_API_KEY=
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Kimi 直连
MOONSHOT_API_KEY=
KIMI_API_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# 其他 OpenAI 兼容服务（也可直接在系统页面配置）
MATERIAL_AI_API_KEY=
MATERIAL_AI_API_BASE_URL=
MATERIAL_AI_MODEL=

# 可选：继续使用已部署的 Dify，或将其设为备用分析服务。
DIFY_API_BASE_URL=https://dify.legalkit.xyz/v1
DIFY_API_KEY_SCENARIO_TRIAGE=
DIFY_ENABLE=false

# 可选：覆盖本地 SQLite 文件位置。
PIPL_DATABASE_PATH=
