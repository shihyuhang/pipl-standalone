{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipl.local/schemas/dify/knowledge-metadata-schema.v1.json",
  "title": "Dify Shared Official Knowledge Chunk Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_code", "source_type", "article_locator", "topic_tags",
    "official_item_codes", "content_hash", "official_url", "verification_status"
  ],
  "properties": {
    "source_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$" },
    "source_type": {
      "enum": [
        "law", "administrative_regulation", "department_rule",
        "official_rule", "official_form", "official_explanation"
      ]
    },
    "article_locator": { "type": "string", "minLength": 1, "maxLength": 300 },
    "topic_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" }
    },
    "official_item_codes": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[AP][0-9]{2}(?:\\.D[1-3])?$" }
    },
    "content_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "official_url": { "type": "string", "format": "uri" },
    "source_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "supersedes_source_version": { "type": ["string", "null"], "maxLength": 100 },
    "verification_status": { "enum": ["verified", "retired"] },
    "schema_version": { "const": "1.0.0" }
  }
}
